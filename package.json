{
  "name": "bookmark-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source Manifest V3 Chrome extension to archive and export X (Twitter) bookmarks to private local TXT files.",
  "keywords": [
    "chrome-extension",
    "x-bookmarks",
    "twitter-bookmarks",
    "bookmark-export",
    "manifest-v3"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasDitchun/export-bookmarks-x-twitter.git"
  },
  "bugs": {
    "url": "https://github.com/LucasDitchun/export-bookmarks-x-twitter/issues"
  },
  "homepage": "https://github.com/LucasDitchun/export-bookmarks-x-twitter#readme",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:chrome": "node scripts/chrome-smoke.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.33",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "archiver": "^8.0.0",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  }
}
